{
  "name": "yunzai-micro-plugin",
  "version": "0.1.1",
  "description": "Yunzai开发管理面板",
  "main": "dist/backend/index.js",
  "type": "module",
  "bin": {
    "micro": "./scripts/micro-bin.js"
  },
  "scripts": {
    "dev": "node scripts/check-backend-deps.mjs && (tsx watch --no-warnings --tsconfig ./src/backend/tsconfig.json ./yunzaijs.js)",
    "app": "node scripts/check-backend-deps.mjs && (tsx --no-warnings --tsconfig ./src/backend/tsconfig.json ./yunzaijs.js)",
    "build": "tsup --clean",
    "test": "tsx --no-warnings test/test.ts",
    "install:dev": "node --experimental-modules scripts/check-dev-deps.mjs && yarn install",
    "dev:frontend": "node scripts/check-frontend-deps.mjs && vite --config ./src/frontend/vite.config.ts",
    "build:frontend": "node scripts/check-frontend-deps.mjs && node scripts/clear-frontend-assets.js && run-p type-check:frontend \"build-only:frontend {@}\" --",
    "build-only:frontend": "vite build --config ./src/frontend/vite.config.ts",
    "type-check:frontend": "vue-tsc --build src/frontend",
    "preview:frontend": "vite preview --config ./src/frontend/vite.config.ts",
    "diff-code": "git diff --exit-code",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint --fix ./",
    "commit": "lint-staged --config .lintstagedrc.js && czg --config=cz.js",
    "commitlint": "commitlint --edit",
    "format": "prettier --config .prettierrc --write .",
    "reset-dev-deps": "node ./scripts/reset-dev-deps",
    "lint-staged": "lint-staged --config .lintstagedrc.js"
  },
  "keywords": [
    "yunzai",
    "micro-plugin",
    "low-code-platform"
  ],
  "author": "Smallv",
  "license": "GPL-3.0-only",
