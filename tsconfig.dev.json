{
  "extends": "@tsconfig/node24/tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.dev.tsbuildinfo",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"]
  },
  "include": [
    "rollup.config.js",
    "eslint.config.*",
    "commitlint.config.*",
    "vitest.config.*",
    "yunzai.config.*",
    "tsup.config.*",
    "./index.js"
  ]
}
