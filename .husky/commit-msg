RESET='\x1b[0m'

# 执行 commitlint 检查
echo -e "${CYAN}[commitlint]${RESET} 开始检查 commit message ...！"
if npm run commitlint; then
    echo -e "${CYAN}[commitlint]${RESET} git commit 格式检查通过！✅ "
else
    echo -e "${RED}[commitlint]${RESET} git commit 格式检查失败！❌ "
    echo -e "${CYAN}[commitlint]${RESET} 请执行以下命令使用commit工具辅助提交："
    echo -e "${CYAN}[commitlint]${RESET} ${YELLOW}npm${RESET} run commit\n"
    exit 1
fi

